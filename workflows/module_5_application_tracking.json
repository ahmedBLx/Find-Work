    },
    {
      "parameters": {
        "jsCode": "const input = $json.body || $json;\nreturn [{\n  json: {\n    candidate_id: input.candidate_id,\n    job_id: input.job_id,\n    company: input.company || '',\n    job_title: input.job_title || '',\n    cv_file: input.cv_file || '',\n    cover_letter_file: input.cover_letter_file || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        180
      ],
      "id": "m5-parse-input",
      "name": "01 - Receive Application Package"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/applications/check-duplicate",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "candidate_id",
              "value": "={{ $json.candidate_id }}"
            },
            {
              "name": "job_id",
              "value": "={{ $json.job_id }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        360,
        180
      ],
      "id": "check-duplicate",
      "name": "02 - Check Duplicate Application"
    },
    {
      "parameters": {
        "jsCode": "const duplicateCheck = $node[\"02 - Check Duplicate Application\"].json;\nconst pkg = $node[\"01 - Receive Application Package\"].json;\n\n// Generate a unique application ID\nconst appId = 'app_' + Math.random().toString(36).substring(2, 8);\n\nreturn [{\n  json: {\n    application_id: appId,\n    duplicate: duplicateCheck.duplicate,\n    package: pkg\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        180
      ],
      "id": "route-duplicate",
      "name": "03 - Handle Duplicate Route"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/applications",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "application_id",
              "value": "={{ $json.application_id }}"
            },
            {
              "name": "candidate_id",
              "value": "={{ $json.package.candidate_id }}"
            },
            {
              "name": "job_id",
              "value": "={{ $json.package.job_id }}"
            },
            {
              "name": "company",
              "value": "={{ $json.package.company }}"
            },
            {
              "name": "job_title",
              "value": "={{ $json.package.job_title }}"
            },
            {
              "name": "approval_decision",
              "value": "={{ $json.duplicate ? 'REJECTED' : 'PENDING' }}"
            },
            {
              "name": "application_status",
              "value": "={{ $json.duplicate ? 'skipped_duplicate' : 'pending_approval' }}"
            },
            {
              "name": "submission_method",
              "value": "mock"
            },
            {
              "name": "attempts",
              "value": 0
            },
            {
              "name": "confirmation_sent",
              "value": false
            },
            {
              "name": "schema_version",
              "value": "1.0"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        680,
        180
      ],
      "id": "register-pending",
      "name": "04 - Register Pending Application",
      "onError": "continueRegularOutput"
