    {
      "parameters": {
        "httpMethod": "POST",
        "path": "m5-decide",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        40,
        420
      ],
      "id": "m5-decide-webhook",
      "name": "m5-decide-webhook"
    },
    {
      "parameters": {
        "url": "=http://localhost:3000/api/applications/{{ $json.body.application_id }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        200,
        420
      ],
      "id": "m5-get-app",
      "name": "Get Application"
    },
    {
      "parameters": {
        "jsCode": "const app = $node[\"Get Application\"].json.application;\nconst body = $node[\"m5-decide-webhook\"].json.body;\nconst decision = body.decision || 'REJECTED';\n\nreturn [{\n  json: {\n    application_id: app.application_id,\n    duplicate: app.application_status === 'skipped_duplicate',\n    package: {\n      candidate_id: app.candidate_id,\n      job_id: app.job_id,\n      company: app.company,\n      job_title: app.job_title,\n      cv_file: app.cv_file || ('tailored_cv_' + app.candidate_id + '.pdf'),\n      cover_letter_file: app.cover_letter_file || ('cover_letter_' + app.candidate_id + '.pdf')\n    },\n    approval_decision: decision,\n    application_status: decision === 'APPROVED' ? 'pending_submission' : 'skipped_human_rejection'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        420
      ],
      "id": "process-approval",
      "name": "06 - Process Human Decision"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/mock/submit-application",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "candidate_id",
              "value": "={{ $json.package.candidate_id }}"
            },
            {
              "name": "job_id",
              "value": "={{ $json.package.job_id }}"
            },
            {
              "name": "cv_file",
              "value": "={{ $json.package.cv_file }}"
            },
            {
              "name": "cover_letter_file",
              "value": "={{ $json.package.cover_letter_file }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        520,
        420
      ],
      "id": "mock-submit",
      "name": "07 - Submit Application Package",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const state = $node[\"06 - Process Human Decision\"].json;\nconst submitRes = $node[\"07 - Submit Application Package\"].json || {};\n\nif (state.application_status === 'skipped_human_rejection') {\n  return [{ json: {\n    schema_version: \"1.0\",\n    application_id: state.application_id,\n    candidate_id: state.package.candidate_id,\n    job_id: state.package.job_id,\n    company: state.package.company,\n    job_title: state.package.job_title,\n    approval_decision: \"REJECTED\",\n    application_status: \"skipped_human_rejection\",\n    submission_method: \"mock\",\n    attempts: 0,\n    confirmation_sent: false\n  }}];\n}\n\nlet status = 'failed';\nlet confSent = false;\nlet errorPayload = null;\n\nif (submitRes.success) {\n  status = 'submitted';\n  confSent = true;\n} else {\n  errorPayload = {\n    code: \"SUBMISSION_FAILED\",\n    message: submitRes.error || \"Portal upload error\",\n    stage: \"submission\"\n  };\n}\n\nreturn [{\n  json: {\n    schema_version: \"1.0\",\n    application_id: state.application_id,\n    candidate_id: state.package.candidate_id,\n    job_id: state.package.job_id,\n    company: state.package.company,\n    job_title: state.package.job_title,\n    approval_decision: \"APPROVED\",\n    application_status: status,\n    submission_method: \"mock\",\n    attempts: 1,\n    confirmation_sent: confSent,\n    error: errorPayload\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        420
      ],
      "id": "record-outcome",
      "name": "08 - Record Submission Outcome"
    },
