    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/validate-contract",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "schema_type",
              "value": "application_status"
            },
            {
              "name": "payload",
              "value": "={{ $node[\"08 - Record Submission Outcome\"] ? $node[\"08 - Record Submission Outcome\"].json : $node[\"11 - Process Timeout Decision\"].json }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1020,
        420
      ],
      "id": "validate-contract",
      "name": "10 - Validate Contract"
    },
    {
      "parameters": {
        "jsCode": "const check = $node[\"10 - Validate Contract\"].json;\nif (!check.valid) {\n  throw new Error('Contract schema violation on application_status: ' + JSON.stringify(check.errors));\n}\nreturn [{ json: $node[\"08 - Record Submission Outcome\"] ? $node[\"08 - Record Submission Outcome\"].json : $node[\"11 - Process Timeout Decision\"].json }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        420
      ],
      "id": "return-status",
      "name": "12 - Return Final Status"
    },
    {
      "parameters": {
        "jsCode": "const registerRes = $node[\"04 - Register Pending Application\"].json || {};\nif (registerRes.error) {\n  return [{ json: { success: false, message: registerRes.error.message } }];\n}\n\nconst duplicate = $node[\"03 - Handle Duplicate Route\"].json.duplicate;\nconst appId = $node[\"03 - Handle Duplicate Route\"].json.application_id;\nconst pkg = $node[\"03 - Handle Duplicate Route\"].json.package;\n\nreturn [{\n  json: {\n    application_id: appId,\n    candidate_id: pkg.candidate_id,\n    job_id: pkg.job_id,\n    company: pkg.company || '',\n    job_title: pkg.job_title || '',\n    approval_decision: duplicate ? 'REJECTED' : 'PENDING',\n    application_status: duplicate ? 'skipped_duplicate' : 'pending_approval',\n    submission_method: 'mock',\n    attempts: 0,\n    confirmation_sent: false\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        180
      ],
      "id": "return-intake-status",
      "name": "05 - Return Intake Status"
    }
  ],
