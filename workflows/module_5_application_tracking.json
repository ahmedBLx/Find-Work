      "parameters": {
        "jsCode": "const app = $node[\"Get Application for Timeout\"].json.application;\nreturn [{\n  json: {\n    schema_version: \"1.0\",\n    application_id: app.application_id,\n    candidate_id: app.candidate_id,\n    job_id: app.job_id,\n    company: app.company,\n    job_title: app.job_title,\n    approval_decision: \"REJECTED\",\n    application_status: \"skipped_timeout\",\n    submission_method: \"mock\",\n    attempts: 0,\n    confirmation_sent: false,\n    error: {\n      code: \"TIMEOUT\",\n      message: \"No response from human operator before timeout.\",\n      stage: \"approval\"\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
